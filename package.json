{
  "name": "fragged-forums",
  "version": "0.1.0",
  "description": "Fragged Forums: an open-source, retro-style forum and social platform with a module system",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs --client",
    "typecheck": "tsc --noEmit -p .",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:generate": "drizzle-kit generate",
    "test:pg": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "modules:sync": "node scripts/sync-modules.mjs",
    "predev": "node scripts/sync-modules.mjs",
    "pretest": "node scripts/sync-modules.mjs",
    "pretest:pg": "node scripts/sync-modules.mjs",
    "pretypecheck": "node scripts/sync-modules.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": { "./sdk": "./src/sdk/index.ts" },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": { "node": ">=22" }
}
