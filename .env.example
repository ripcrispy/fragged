# Copy to .env (or set in your process manager / secrets store). Never commit real secrets.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public origin: used for links in email, OAuth redirect URIs and Origin checks
APP_URL=https://forums.example.org
# Extra exact origins allowed to submit forms, comma separated (APP_URL is always allowed).
# Useful in development when the same server is reached by IP and hostname. No wildcards.
# ALLOWED_ORIGINS=http://localhost:3000,http://10.0.0.189:3000
# PostgreSQL 15+ (required in production)
DATABASE_URL=postgres://fragged:change-me@localhost:5432/fragged
# 32+ random bytes, e.g. `openssl rand -base64 48`
APP_SECRET=
# Set when behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=1
DATA_DIR=/var/lib/fragged
# SMTP transport, e.g. smtp://user:pass@smtp.example.org:587
SMTP_URL=
MAIL_FROM=Fragged Forums <no-reply@example.org>
LOG_LEVEL=info

# Sign-in providers (each provider is enabled only when its variables are set, and can be toggled in Admin › Sign-in providers)
# Redirect URI to register with each provider: ${APP_URL}/auth/<provider>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
# PKCS#8 PEM; literal \n sequences are accepted
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# LAN Event Access module: firewall API credentials (see modules/lan-event-access/README.md)
# OPNsense: API key + secret. pfSense REST API package: API key only.
LAN_EVENT_ACCESS_API_KEY=
LAN_EVENT_ACCESS_API_SECRET=
# Optional PEM file to trust the firewall's own certificate authority
# LAN_EVENT_ACCESS_CA_FILE=

# Development only — never in production
# AUTH_DEV_PROVIDER=1

# Public URL of the source code for this deployment (AGPL-3.0 §13); adds a "Source code" footer link.
# SOURCE_URL=https://github.com/your-org/fragged-forums
